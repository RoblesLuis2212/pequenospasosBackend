generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoProducto {
  DISPONIBLE
  INACTIVO
}

model Producto {
  idProducto               Int            @id @default(autoincrement())
  nombre                   String
  precio                   Decimal
  stock                    Int
  descripcion              String
  fechaCreacion            DateTime       @default(now())
  imagen                   String
  fechaUltimaActualizacion DateTime       @updatedAt
  codigoBarras             String         @unique
  estado                   EstadoProducto @default(DISPONIBLE)

  categoriaId Int?
  categoria   Categoria? @relation(fields: [categoriaId], references: [idCategoria])

  detalles        DetalleVenta[]
  detalleCarritos DetalleCarrito[]
}

model Categoria {
  idCategoria Int        @id @default(autoincrement())
  nombre      String     @unique
  productos   Producto[]
}

enum EstadoVenta {
  PENDIENTE
  APROBADO
  RETIRADO
  CANCELADO
  PAGADO
}

enum TipoVenta {
  PRODUCTO
  CONSULTA
}

model Ventas {
  idVenta     Int         @id @default(autoincrement())
  fechaCompra DateTime    @default(now())
  fechaRetiro DateTime?
  monto       Decimal
  pagoCon     Decimal?
  vuelto      Decimal?
  descripcion String?
  estado      EstadoVenta @default(PENDIENTE)
  tipoVenta   TipoVenta

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [idUsuario])

  turnoId Int?
  turno   Turno? @relation(fields: [turnoId], references: [idTurno])

  carritoId Int?
  carrito   Carrito? @relation(fields: [carritoId], references: [idCarrito])

  metodoPagoId Int?
  metodopago   MetodoPago? @relation(fields: [metodoPagoId], references: [idMetodoPago])

  cajaId Int?
  caja   Caja? @relation(fields: [cajaId], references: [idCaja])

  detalles DetalleVenta[]
}

model DetalleVenta {
  idDetalleVenta  Int     @id @default(autoincrement())
  cantidad        Int
  precio_unitario Decimal

  ventaId Int
  venta   Ventas @relation(fields: [ventaId], references: [idVenta])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [idProducto])
}

enum NombreMetodoPago {
  TRANSFERENCIA
  DEBITO
  CREDITO
  EFECTIVO
}

model MetodoPago {
  idMetodoPago Int              @id @default(autoincrement())
  nombre       NombreMetodoPago @unique
  ventas       Ventas[]
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

model Usuario {
  idUsuario      Int           @id @default(autoincrement())
  nombreCompleto String
  telefono       String
  email          String        @unique
  password       String
  estado         EstadoUsuario @default(ACTIVO)
  pacientes      Paciente[]

  rolId         Int
  rol           RolUsuario     @relation(fields: [rolId], references: [idRol])
  turnos        Turno[]
  tokenUsuarios TokenUsuario[]
  carritos      Carrito[]
  cajas         Caja[]
  ventas        Ventas[]
}

enum Rol {
  ADMIN
  PADRE
  EMPLEADO
}

model RolUsuario {
  idRol    Int       @id @default(autoincrement())
  nombre   Rol       @unique
  usuarios Usuario[]
}

enum TipoToken {
  RECUPERACION_CONTRASENA
  VALIDACION_CORREO
}

model TokenUsuario {
  idToken         Int       @id @default(autoincrement())
  token           String    @unique
  fechaCreacion   DateTime  @default(now())
  fechaExpiracion DateTime
  tipo            TipoToken
  usado           Boolean   @default(false)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [idUsuario])
}

model Paciente {
  idPaciente      Int      @id @default(autoincrement())
  nombreCompleto  String
  dni             String   @unique
  domicilio       String
  fechaNacimiento DateTime

  usuarioId          Int?
  usuario            Usuario?            @relation(fields: [usuarioId], references: [idUsuario])
  fichaMedicas       FichaMedica[]
  datosEscolares     DatosEscolares[]
  obraSocialId       Int?
  obraSocial         ObraSocial?         @relation(fields: [obraSocialId], references: [idObraSocial])
  evolucionPacientes EvolucionPaciente[]
  turnos             Turno[]
}

model FichaMedica {
  idFicha         Int     @id @default(autoincrement())
  edad_camino     String?
  socializacion   String?
  derivacion      String?
  horarios_sueno  String?
  contacto_visual String?
  actividades     String?

  pacienteId Int      @unique
  paciente   Paciente @relation(fields: [pacienteId], references: [idPaciente])
}

enum TurnoCursado {
  MANANA
  TARDE
  NOCHE
}

model DatosEscolares {
  idDatosEscolares Int          @id @default(autoincrement())
  escuela          String
  turno            TurnoCursado

  paciente           Paciente @relation(fields: [pacienteIdPaciente], references: [idPaciente])
  pacienteIdPaciente Int      @unique
}

enum estadoObraSocial {
  ACTIVA
  INACTIVA
}

model ObraSocial {
  idObraSocial     Int              @id @default(autoincrement())
  nombre           String           @unique
  precioConsulta   Decimal
  duracionConsulta String
  estado           estadoObraSocial @default(ACTIVA)

  paciente Paciente[]
}

model EvolucionPaciente {
  idEvolucion Int      @id @default(autoincrement())
  descripcion String
  fecha       DateTime @default(now())

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [idPaciente])
}

enum EstadoTurno {
  PENDIENTE
  APROBADO
  CANCELADO
  FINALIZADO
}

model Turno {
  idTurno Int         @id @default(autoincrement())
  estado  EstadoTurno @default(PENDIENTE)
  fecha   DateTime

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [idPaciente])

  ventas           Ventas[]
  usuario          Usuario? @relation(fields: [usuarioIdUsuario], references: [idUsuario])
  usuarioIdUsuario Int?
}

enum EstadoCarrito {
  ACTIVO
  PENDIENTE
  COMPRADO
}

model Carrito {
  idCarrito Int           @id @default(autoincrement())
  estado    EstadoCarrito @default(ACTIVO)

  usuarioId       Int
  usuario         Usuario          @relation(fields: [usuarioId], references: [idUsuario])
  detalleCarritos DetalleCarrito[]
  ventas          Ventas[]
}

model DetalleCarrito {
  idDetalleCarrito Int     @id @default(autoincrement())
  cantidad         Int
  precio_unitario  Decimal

  carritoId Int
  carrito   Carrito @relation(fields: [carritoId], references: [idCarrito])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [idProducto])
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

model Caja {
  idCaja        Int       @id @default(autoincrement())
  fechaApertura DateTime  @default(now())
  fechaCierre   DateTime?
  montoCierre   Decimal?

  usuarioId Int
  usuario   Usuario    @relation(fields: [usuarioId], references: [idUsuario])
  ventas    Ventas[]
  estado    EstadoCaja @default(ABIERTA)
}
